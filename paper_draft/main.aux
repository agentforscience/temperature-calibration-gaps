\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Open-ended generation. The slope ratio divides the diversity slope over $T \in [1.2, 2.0]$ by the slope over $[0.2, 1.2]$. Most models lose about half their judge score by $T = 1.4$, and the coherent rate shows the loss is near total. Best value in each column is in \textbf  {bold}, except at $T = 2.0$, where all models sit at the judge's floor.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:stories}{{3}{6}{Open-ended generation. The slope ratio divides the diversity slope over $T \in [1.2, 2.0]$ by the slope over $[0.2, 1.2]$. Most models lose about half their judge score by $T = 1.4$, and the coherent rate shows the loss is near total. Best value in each column is in \textbf {bold}, except at $T = 2.0$, where all models sit at the judge's floor}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Diversity against coherence as $T$ rises, with hollow markers at $T = 1.2$. Coherence stays flat while diversity rises, then drops steeply. {\em  (Left)}: semantic diversity turns back on itself past the cliff. {\em  (Right)}: distinct-2 presses against its ceiling.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:frontier}{{4}{6}{Diversity against coherence as $T$ rises, with hollow markers at $T = 1.2$. Coherence stays flat while diversity rises, then drops steeply. \figleft : semantic diversity turns back on itself past the cliff. \figright : distinct-2 presses against its ceiling}{figure.4}{}}
