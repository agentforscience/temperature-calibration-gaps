\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Factual QA. The difference compares $T$ of 0.8--1.0 with $T \le 0.7$. Accuracy falls in every model and significantly in nine, but only by a few points. coverage@4\xspace  shows no consistent gain from 0.7 to 1.0. $p$-values use 10,000 permutations, so ``$<$.001'' is near the resolution limit. Best values are in \textbf  {bold}.}}{7}{table.4}\protected@file@percent }
\newlabel{tab:qa}{{4}{7}{Factual QA. The difference compares $T$ of 0.8--1.0 with $T \le 0.7$. Accuracy falls in every model and significantly in nine, but only by a few points. \coverfour shows no consistent gain from 0.7 to 1.0. $p$-values use 10,000 permutations, so ``$<$.001'' is near the resolution limit. Best values are in \textbf {bold}}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Code generation. Best $T$ maximizes pass@1\xspace  . Larger models hold their pass@1\xspace  far past $T = 0.8$, while the four significant drops from 0.6 to 1.0 are all at 3B or below. \ensuremath  {T_u}\xspace  CIs are wide because curves are flat near the threshold. Best values are in \textbf  {bold}.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:code}{{5}{7}{Code generation. Best $T$ maximizes \passone . Larger models hold their \passone far past $T = 0.8$, while the four significant drops from 0.6 to 1.0 are all at 3B or below. \Tu CIs are wide because curves are flat near the threshold. Best values are in \textbf {bold}}{table.5}{}}
