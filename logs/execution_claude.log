)]\n        todo = [k for k in queue if MODELS[k][\"need\"] <= max_gb and n_fails(k) < 2 and not complete(k)]\n        if not todo:\n            log(\"nothing left for this worker; exiting (memory goes back to the host)\")\n            return\n        for key in todo:\n            lock = open(GENS / f\"{key}.lock\", \"w\")\n            try:\n                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except OSError:\n                lock.close(); continue                     # another worker has it\n            if not grab(MODELS[key][\"need\"], timeout=30):\n                lock.close(); continue\n            grab(min(max_gb, MODELS[key][\"need\"] + 4), timeout=5)   # a bit of extra KV if it's free\n            before = held()\n            ok = False\n            try:\n                run_model(key)\n                ok = True\n            except Exception as e:\n                import traceback; traceback.print_exc(); log(f\"FAILED {key}: {e}\")\n                (LOGS / f\"fails_{key}\").write_text(str(n_fails(key) + 1))\n            lock.close()\n            log(f\"{'done' if ok else 'failed'} {key}; handing over\")\n            handoff(qfile, max_gb, before)\n        time.sleep(20)                                     # everything locked or too big for now\n    log(\"STOP seen; exiting\")\n\n\n'''+s[b:]\ns=s.replace('import os, sys, json, time, gc, fcntl, random\\n','import os, sys, json, time, gc, fcntl, random, subprocess\\n',1)\ns=s.replace('MAX_TOKENS = {\"story\": 256, \"qa\": 24, \"code\": 448}\\n','MAX_TOKENS = {\"story\": 256, \"qa\": 24, \"code\": 448}\\nN_PROMPTS = 564\\n',1)\nopen(p,'w').write(s)\nEOF\n.venv/bin/python -c \"import ast;ast.parse(open('src/worker.py').read())\"\nprintf \"qwen2.5-3b\\nllama3.2-3b\\n\" > logs/queue_small.txt\nsed -i '/llama3.2-1b/d' logs/queue_gpu0c.txt\nNEW(){ NUMPY_MADVISE_HUGEPAGE=0 CUDA_VISIBLE_DEVICES=$1 TAKEOVER_PID=$2 TAKEOVER_GB=$3 nohup .venv/bin/python src/worker.py $4 $5 > logs/worker3_$6.log 2>